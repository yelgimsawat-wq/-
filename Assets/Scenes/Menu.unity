  m_Script: {fileID: 11500000, guid: e5dac6de1135a3c4487e6d52a3e8fd24, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MagicDrawing.SpellHintLabel
  label: {fileID: 1943947313}
  idleHint: "A/D \u0E40\u0E14\u0E34\u0E19  |  W \u0E01\u0E23\u0E30\u0E42\u0E14\u0E14 
    |  \u0E25\u0E32\u0E01\u0E40\u0E21\u0E32\u0E2A\u0E4C\u0E40\u0E02\u0E35\u0E22\u0E19\u0E04\u0E32\u0E16\u0E32\n\u0E27\u0E07\u0E01\u0E25\u0E21=\u0E19\u0E49\u0E33 
    \u0E2A\u0E32\u0E21\u0E40\u0E2B\u0E25\u0E35\u0E48\u0E22\u0E21=\u0E44\u0E1F  \u0E2A\u0E35\u0E48\u0E40\u0E2B\u0E25\u0E35\u0E48\u0E22\u0E21=\u0E14\u0E34\u0E19 
    \u0E02\u0E35\u0E14 4 \u0E02\u0E35\u0E14=\u0E25\u0E21"
  composingHint: "\u0E40\u0E02\u0E35\u0E22\u0E19\u0E04\u0E32\u0E16\u0E32 {0} \u0E02\u0E35\u0E14 
    |  Space = \u0E22\u0E37\u0E19\u0E22\u0E31\u0E19  |  Esc = \u0E25\u0E49\u0E32\u0E07"
  aimingHint: "\u0E40\u0E27\u0E17{0} \u0E1E\u0E23\u0E49\u0E2D\u0E21\u0E41\u0E25\u0E49\u0E27 
    |  \u0E40\u0E25\u0E37\u0E48\u0E2D\u0E19\u0E40\u0E21\u0E32\u0E2A\u0E4C\u0E40\u0E25\u0E47\u0E07 
    |  \u0E15\u0E30\u0E42\u0E01\u0E19\u0E43\u0E2B\u0E49\u0E16\u0E36\u0E07\u0E40\u0E2A\u0E49\u0E19\u0E02\u0E32\u0E27\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E22\u0E34\u0E07 
    |  Esc = \u0E22\u0E01\u0E40\u0E25\u0E34\u0E01"
